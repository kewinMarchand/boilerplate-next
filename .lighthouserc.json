{
  "ci": {
    "collect": {
      "startServerCommand": "yarn start --port 4019",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://localhost:4019/",
        "http://localhost:4019/taches",
        "http://localhost:4019/contact",
        "http://localhost:4019/catalogue",
        "http://localhost:4019/catalogue/plantes-interieur",
        "http://localhost:4019/catalogue/plantes-interieur/feuillages",
        "http://localhost:4019/mentions-legales",
        "http://localhost:4019/donnees-personnelles",
        "http://localhost:4019/accessibilite",
        "http://localhost:4019/plan-du-site",
        "http://localhost:4019/blog",
        "http://localhost:4019/blog/le-mode-accessibilite-renforcee",
        "http://localhost:4019/produit/monstera-deliciosa"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^http://localhost:4019/$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.85,
                "aggregationMethod": "median"
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 1,
                "aggregationMethod": "median"
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 1,
                "aggregationMethod": "median"
              }
            ],
            "categories:best-practices": [
              "warn",
              {
                "minScore": 0.9,
                "aggregationMethod": "median"
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:4019/.+",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.9,
                "aggregationMethod": "median"
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 1,
                "aggregationMethod": "median"
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 1,
                "aggregationMethod": "median"
              }
            ],
            "categories:best-practices": [
              "warn",
              {
                "minScore": 0.9,
                "aggregationMethod": "median"
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
